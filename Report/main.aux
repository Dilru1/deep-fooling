\@writefile{toc}{\contentsline {section}{\numberline {3}State of the Art}{6}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Implementation Framework and Training Protocol}{6}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Agent Architecture and Policy Network}{7}{subsection.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Temporal Feature Extraction with 1D-CNNs}{7}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Proposed PPO Actor-Critic network featuring a history-based 1D-CNN feature extractor. The input comprises a temporal stack of 4 consecutive observations ($\DOTSB \sum@ \slimits@ _{i=0}^{3} \mathbf  {o}_{t-i}$). With each observation vector containing 19 physical features, the resulting 76-dimensional input is reshaped into a $(19 \text  { channels} \times 4 \text  { time steps})$ tensor. The CNN architecture employs two Conv1D layers to extract temporal patterns, which are then projected into a 128-dimensional latent representation. This embedding is shared by the Actor and Critic MLP branches to determine the optimal 3D action vector and scalar state value, respectively.\relax }}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:1dcnn}{{7}{7}{Proposed PPO Actor-Critic network featuring a history-based 1D-CNN feature extractor. The input comprises a temporal stack of 4 consecutive observations ($\sum _{i=0}^{3} \mathbf {o}_{t-i}$). With each observation vector containing 19 physical features, the resulting 76-dimensional input is reshaped into a $(19 \text { channels} \times 4 \text { time steps})$ tensor. The CNN architecture employs two Conv1D layers to extract temporal patterns, which are then projected into a 128-dimensional latent representation. This embedding is shared by the Actor and Critic MLP branches to determine the optimal 3D action vector and scalar state value, respectively.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Hierarchical dataflow through the 1D-CNN feature extractor. \textbf  {Panel 1:} Raw input matrix ($19 \text  { features} \times 4 \text  { steps}$). \textbf  {Panel 2:} After the first convolution ($k=2$), the temporal dimension is reduced to 3; the 32 feature channels act as first-order differential operators. \textbf  {Panel 3:} The second convolution reduces the temporal window to 2, processing velocity signals to extract second-order dynamics (acceleration). \textbf  {Panel 4:} The latent representation, flattened to $64 \text  { channels} \times 2 \text  { steps} = 128$, provides a high-level physical abstraction for the Actor-Critic heads.\relax }}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:dataflow}{{8}{8}{Hierarchical dataflow through the 1D-CNN feature extractor. \textbf {Panel 1:} Raw input matrix ($19 \text { features} \times 4 \text { steps}$). \textbf {Panel 2:} After the first convolution ($k=2$), the temporal dimension is reduced to 3; the 32 feature channels act as first-order differential operators. \textbf {Panel 3:} The second convolution reduces the temporal window to 2, processing velocity signals to extract second-order dynamics (acceleration). \textbf {Panel 4:} The latent representation, flattened to $64 \text { channels} \times 2 \text { steps} = 128$, provides a high-level physical abstraction for the Actor-Critic heads.\relax }{figure.caption.9}{}}
